{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liammaher/pratiche-napoli/contract/procedure.schema.json",
  "title": "Procedure",
  "description": "One bureaucratic procedure, described so people and AIs can understand and prepare it. No personal data: forms refer to field IDs from contract/fields.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "headline",
    "updated",
    "summary",
    "ente",
    "applies_to",
    "channels",
    "steps",
    "sources",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": 0
    },
    "id": {
      "description": "Path-like id; must match the file path under procedures/ without .yaml",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)+$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "pattern": "\\S"
    },
    "headline": {
      "description": "The page title in the words people search with, a question or an action (\"Come iscriversi alla TARI a Napoli dopo un trasloco\"); title stays the official name",
      "type": "string",
      "minLength": 10,
      "maxLength": 90,
      "pattern": "\\S"
    },
    "aka": {
      "description": "Everyday names people use for this procedure (\"tassa sulla spazzatura\"), for search",
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "uniqueItems": true
    },
    "updated": {
      "description": "The last day anything in this procedure changed, apart from this field and YAML comments or layout. Bump it with every change: the site and the JSON publish it as the page's last update, and CI checks it on pull requests",
      "type": "string",
      "format": "date"
    },
    "summary": {
      "description": "Two or three plain-Italian sentences: what it is and who it is for",
      "type": "string",
      "minLength": 10,
      "pattern": "\\S"
    },
    "ente": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "office": {
          "$ref": "#/$defs/text"
        },
        "ipa": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "audience"
      ],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "open",
              "change",
              "move",
              "hire",
              "renovate",
              "signage",
              "dehors",
              "food",
              "events",
              "close",
              "annual",
              "inspection",
              "letter",
              "home"
            ]
          },
          "uniqueItems": true
        },
        "audience": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "business",
              "resident"
            ]
          },
          "uniqueItems": true
        },
        "sectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "legal_basis": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "description": "The deadline in one or two sentences covering every case, for the page's \"In breve\"; required when there is more than one rule",
          "$ref": "#/$defs/claim"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "lateness": {
          "$ref": "#/$defs/claim"
        }
      }
    },
    "cost": {
      "description": "What the procedure costs in total (fees, marche da bollo, diritti), or that it is free; not the tax it registers you for. Shown in the page's \"In breve\"",
      "$ref": "#/$defs/claim"
    },
    "duration": {
      "description": "How long until the result: the office's time limit or the official practice (\"il SUAP ha 60 giorni per i controlli\"). Shown in \"In breve\"",
      "$ref": "#/$defs/claim"
    },
    "appointment": {
      "description": "Whether an appointment is needed, and how to book one. Shown in \"In breve\"",
      "$ref": "#/$defs/claim"
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "purpose"
        ],
        "properties": {
          "purpose": {
            "description": "What the channel is for: procedure, to carry out the procedure itself (file, request, read); info, only questions and assistance; payment; related, another service or a linked step. Only procedure channels answer \"can it be done online\"",
            "enum": [
              "procedure",
              "info",
              "payment",
              "related"
            ]
          },
          "type": {
            "enum": [
              "portal",
              "pec",
              "email",
              "desk",
              "post",
              "phone",
              "app"
            ]
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "url": {
            "$ref": "#/$defs/httpUrl"
          },
          "address": {
            "$ref": "#/$defs/text"
          },
          "auth": {
            "type": "array",
            "items": {
              "enum": [
                "spid",
                "cie",
                "cns",
                "none"
              ]
            },
            "uniqueItems": true
          },
          "hours": {
            "$ref": "#/$defs/text"
          },
          "booking": {
            "$ref": "#/$defs/text"
          },
          "receipt": {
            "enum": [
              "legal",
              "informal",
              "none"
            ]
          },
          "preferred": {
            "type": "boolean"
          },
          "notes": {
            "$ref": "#/$defs/text"
          },
          "source": {
            "description": "id of the source for these contact details",
            "type": "string"
          }
        }
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "enum": [
            "f24",
            "pagopa",
            "bollettino",
            "marca-da-bollo",
            "none"
          ]
        },
        "codice_ente": {
          "$ref": "#/$defs/text"
        },
        "codici_tributo": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "rateazione": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "description": "Status of codice_ente, codici_tributo and rateazione; unverified or disputed puts a warning next to each on the site",
          "$ref": "#/$defs/status"
        },
        "source": {
          "description": "id of the source for codice_ente, codici_tributo and rateazione",
          "type": "string"
        },
        "calculator_url": {
          "$ref": "#/$defs/httpUrl"
        },
        "schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "due"
            ],
            "properties": {
              "label": {
                "$ref": "#/$defs/text"
              },
              "due": {
                "type": "string",
                "format": "date"
              },
              "source": {
                "type": "string"
              },
              "status": {
                "$ref": "#/$defs/status"
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "required"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/text"
          },
          "required": {
            "type": "boolean"
          },
          "notes": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "fields"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "url": {
            "$ref": "#/$defs/httpUrl"
          },
          "source": {
            "description": "id of the source where the form is published",
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "signature_required": {
            "type": "boolean"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "map"
              ],
              "properties": {
                "label": {
                  "$ref": "#/$defs/text"
                },
                "map": {
                  "$ref": "#/$defs/mapping"
                },
                "notes": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "do",
          "who"
        ],
        "properties": {
          "do": {
            "$ref": "#/$defs/text"
          },
          "who": {
            "enum": [
              "owner",
              "facilitator",
              "professional",
              "office",
              "anyone"
            ]
          },
          "human_only": {
            "description": "Signing, paying, sending, swearing, being present: never done by an agent",
            "type": "boolean"
          }
        }
      }
    },
    "after": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "records": {
      "description": "Data the procedure produces that is worth keeping (a codice contribuente, a REA number): one registry field each, and where its value comes from. The person's own tracking of the procedure is not listed here",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "from"
        ],
        "properties": {
          "field": {
            "description": "One exact field ID of the vault owner, no wildcard or member prefix",
            "type": "string",
            "pattern": "^[a-z_]+\\.[a-z0-9_]+$"
          },
          "from": {
            "description": "The document or message the value is read from",
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "pitfalls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)+$"
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "retrieved"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "label": {
            "$ref": "#/$defs/text"
          },
          "url": {
            "$ref": "#/$defs/httpUrl"
          },
          "retrieved": {
            "type": "string",
            "format": "date"
          },
          "page_updated": {
            "type": "string",
            "format": "date"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "official": {
            "type": "boolean"
          },
          "notes": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "date",
        "by",
        "method"
      ],
      "properties": {
        "level": {
          "description": "L0 draft, L1 desk-checked against official sources, L2 confirmed by the office, L3 a real filing went through",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3"
          ]
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "by": {
          "$ref": "#/$defs/text"
        },
        "method": {
          "$ref": "#/$defs/text"
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "ssu_ref": {
      "description": "Reference in the national SSU catalogue, when known",
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "run_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "note"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "reported": {
      "description": "What people who did the procedure reported, generated by npm run reports:aggregate from reviewed reports of the last 12 months; don't edit by hand. It exists only with at least 3 reports, and every number in it, outcome and reason counts included, covers at least 3 reports. Tips, rejection reasons and extra documents are written by a maintainer, never quoted",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated",
        "period",
        "count"
      ],
      "properties": {
        "generated": {
          "type": "string",
          "format": "date"
        },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "$ref": "#/$defs/month"
            },
            "to": {
              "$ref": "#/$defs/month"
            }
          }
        },
        "count": {
          "type": "integer",
          "minimum": 3
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "completata": {
              "type": "integer",
              "minimum": 3
            },
            "chiesto_altro": {
              "type": "integer",
              "minimum": 3
            },
            "respinta": {
              "type": "integer",
              "minimum": 3
            },
            "in_attesa": {
              "type": "integer",
              "minimum": 3
            },
            "rinunciato": {
              "type": "integer",
              "minimum": 3
            }
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "count"
            ],
            "properties": {
              "type": {
                "enum": [
                  "portal",
                  "pec",
                  "email",
                  "desk",
                  "post",
                  "phone",
                  "app"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 3
              },
              "days_to_answer": {
                "$ref": "#/$defs/stat"
              }
            }
          }
        },
        "desk_wait_minutes": {
          "$ref": "#/$defs/stat"
        },
        "paid_eur": {
          "$ref": "#/$defs/stat"
        },
        "documents": {
          "description": "Listed documents, with how many of the reports that answered about each said it was asked for",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "asked",
              "of"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/text"
              },
              "asked": {
                "type": "integer",
                "minimum": 0
              },
              "of": {
                "type": "integer",
                "minimum": 3
              }
            }
          }
        },
        "extra_documents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "count"
            ],
            "properties": {
              "text": {
                "$ref": "#/$defs/text"
              },
              "count": {
                "type": "integer",
                "minimum": 3
              }
            }
          }
        },
        "rejection_reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "count"
            ],
            "properties": {
              "text": {
                "$ref": "#/$defs/text"
              },
              "count": {
                "type": "integer",
                "minimum": 3
              }
            }
          }
        },
        "tips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "status": {
      "description": "verified: an official source says so; unverified: believed but not yet checked; disputed: sources disagree",
      "enum": [
        "verified",
        "unverified",
        "disputed"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "status"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "source": {
          "description": "id of a source in this procedure",
          "type": "string"
        }
      }
    },
    "fieldRef": {
      "description": "A field ID (category.field) or a whole category (category.*), the vault owner's when unprefixed. A family member's carry their slug (leo:identity.first_name; io is reserved for the owner), and *: means each member (*:identity.first_name)",
      "type": "string",
      "pattern": "^(?:(?:\\*|[a-z][a-z0-9-]{0,31}):)?[a-z_]+\\.([a-z0-9_]+|\\*)$"
    },
    "mapping": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direct"
          ],
          "properties": {
            "direct": {
              "$ref": "#/$defs/fieldRef"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "concat"
          ],
          "properties": {
            "concat": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/fieldRef"
              }
            }
          }
        },
        {
          "description": "Use the first source that has a value",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fallback"
          ],
          "properties": {
            "fallback": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/fieldRef"
              }
            }
          }
        },
        {
          "description": "One row per family member in the vault owner's stato di famiglia (famiglia.stato_famiglia si), filled from that member's fields, written *:category.field",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repeat",
            "fields"
          ],
          "properties": {
            "repeat": {
              "const": "famiglia"
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/fieldRef"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blank_with_reason"
          ],
          "properties": {
            "blank_with_reason": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "description": "Not in the field registry yet: ask the person",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ask"
          ],
          "properties": {
            "ask": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "httpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^/?#\\s]+"
    },
    "month": {
      "type": "string",
      "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
    },
    "stat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "median",
        "n"
      ],
      "properties": {
        "median": {
          "type": "number",
          "minimum": 0
        },
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "n": {
          "type": "integer",
          "minimum": 3
        }
      }
    }
  }
}
