{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liammaher/pratiche-napoli/contract/procedure.schema.json",
  "title": "Procedure",
  "description": "One bureaucratic procedure, described so people and AIs can understand and prepare it. No personal data: forms refer to field IDs from contract/fields.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "summary",
    "ente",
    "applies_to",
    "channels",
    "steps",
    "sources",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": 0
    },
    "id": {
      "description": "Path-like id; must match the file path under procedures/ without .yaml",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)+$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "pattern": "\\S"
    },
    "summary": {
      "description": "Two or three plain-Italian sentences: what it is and who it is for",
      "type": "string",
      "minLength": 10,
      "pattern": "\\S"
    },
    "ente": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "office": {
          "$ref": "#/$defs/text"
        },
        "ipa": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "audience"
      ],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "open",
              "change",
              "move",
              "hire",
              "renovate",
              "signage",
              "dehors",
              "food",
              "events",
              "close",
              "annual",
              "inspection",
              "letter",
              "home"
            ]
          },
          "uniqueItems": true
        },
        "audience": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "business",
              "resident"
            ]
          },
          "uniqueItems": true
        },
        "sectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "legal_basis": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "lateness": {
          "$ref": "#/$defs/claim"
        }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "portal",
              "pec",
              "email",
              "desk",
              "post",
              "phone",
              "app"
            ]
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "url": {
            "$ref": "#/$defs/httpUrl"
          },
          "address": {
            "$ref": "#/$defs/text"
          },
          "auth": {
            "type": "array",
            "items": {
              "enum": [
                "spid",
                "cie",
                "cns",
                "none"
              ]
            },
            "uniqueItems": true
          },
          "hours": {
            "$ref": "#/$defs/text"
          },
          "booking": {
            "$ref": "#/$defs/text"
          },
          "receipt": {
            "enum": [
              "legal",
              "informal",
              "none"
            ]
          },
          "preferred": {
            "type": "boolean"
          },
          "notes": {
            "$ref": "#/$defs/text"
          },
          "source": {
            "description": "id of the source for these contact details",
            "type": "string"
          }
        }
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "enum": [
            "f24",
            "pagopa",
            "bollettino",
            "marca-da-bollo",
            "none"
          ]
        },
        "codice_ente": {
          "$ref": "#/$defs/text"
        },
        "codici_tributo": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "rateazione": {
          "$ref": "#/$defs/text"
        },
        "calculator_url": {
          "$ref": "#/$defs/httpUrl"
        },
        "schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "due"
            ],
            "properties": {
              "label": {
                "$ref": "#/$defs/text"
              },
              "due": {
                "type": "string",
                "format": "date"
              },
              "source": {
                "type": "string"
              },
              "status": {
                "$ref": "#/$defs/status"
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "required"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/text"
          },
          "required": {
            "type": "boolean"
          },
          "notes": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "fields"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "url": {
            "$ref": "#/$defs/httpUrl"
          },
          "source": {
            "description": "id of the source where the form is published",
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "signature_required": {
            "type": "boolean"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "map"
              ],
              "properties": {
                "label": {
                  "$ref": "#/$defs/text"
                },
                "map": {
                  "$ref": "#/$defs/mapping"
                },
                "notes": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "do",
          "who"
        ],
        "properties": {
          "do": {
            "$ref": "#/$defs/text"
          },
          "who": {
            "enum": [
              "owner",
              "facilitator",
              "professional",
              "office",
              "anyone"
            ]
          },
          "human_only": {
            "description": "Signing, paying, sending, swearing, being present: never done by an agent",
            "type": "boolean"
          }
        }
      }
    },
    "after": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "records": {
      "description": "Data the procedure produces that is worth keeping (a codice contribuente, a REA number): one registry field each, and where its value comes from. The person's own tracking of the procedure is not listed here",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "from"],
        "properties": {
          "field": {
            "description": "One exact field ID of the vault owner, no wildcard or member prefix",
            "type": "string",
            "pattern": "^[a-z_]+\\.[a-z0-9_]+$"
          },
          "from": {
            "description": "The document or message the value is read from",
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "pitfalls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)+$"
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "retrieved"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "label": {
            "$ref": "#/$defs/text"
          },
          "url": {
            "$ref": "#/$defs/httpUrl"
          },
          "retrieved": {
            "type": "string",
            "format": "date"
          },
          "page_updated": {
            "type": "string",
            "format": "date"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "official": {
            "type": "boolean"
          },
          "notes": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "date",
        "by",
        "method"
      ],
      "properties": {
        "level": {
          "description": "L0 draft, L1 desk-checked against official sources, L2 confirmed by the office, L3 a real filing went through",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3"
          ]
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "by": {
          "$ref": "#/$defs/text"
        },
        "method": {
          "$ref": "#/$defs/text"
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "ssu_ref": {
      "description": "Reference in the national SSU catalogue, when known",
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "run_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "note"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "$ref": "#/$defs/text"
          }
        }
      }
    }
  },
  "$defs": {
    "status": {
      "description": "verified: an official source says so; unverified: believed but not yet checked; disputed: sources disagree",
      "enum": [
        "verified",
        "unverified",
        "disputed"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "status"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "source": {
          "description": "id of a source in this procedure",
          "type": "string"
        }
      }
    },
    "fieldRef": {
      "description": "A field ID (category.field) or a whole category (category.*), the vault owner's when unprefixed. A family member's carry their slug (leo:identity.first_name; io is reserved for the owner), and *: means each member (*:identity.first_name)",
      "type": "string",
      "pattern": "^(?:(?:\\*|[a-z][a-z0-9-]{0,31}):)?[a-z_]+\\.([a-z0-9_]+|\\*)$"
    },
    "mapping": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direct"
          ],
          "properties": {
            "direct": {
              "$ref": "#/$defs/fieldRef"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "concat"
          ],
          "properties": {
            "concat": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/fieldRef"
              }
            }
          }
        },
        {
          "description": "Use the first source that has a value",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fallback"
          ],
          "properties": {
            "fallback": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/fieldRef"
              }
            }
          }
        },
        {
          "description": "One row per family member in the vault owner's stato di famiglia (famiglia.stato_famiglia si), filled from that member's fields, written *:category.field",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repeat",
            "fields"
          ],
          "properties": {
            "repeat": {
              "const": "famiglia"
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/fieldRef"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blank_with_reason"
          ],
          "properties": {
            "blank_with_reason": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "description": "Not in the field registry yet: ask the person",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ask"
          ],
          "properties": {
            "ask": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "httpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^/?#\\s]+"
    }
  }
}
